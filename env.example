# Copy to .env and edit:  cp env.example .env
# Never commit the real .env file.

# --- Image selection (docker-compose.yml) ---
# Full image reference. Pin a version tag or sha-<short> for repeatable deploys.
RIFFLE_IMAGE=ghcr.io/fubarpie/riffle-accounting:latest

# Host port the web UI / API is published on.
RIFFLE_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=riffle
POSTGRES_DB=riffle
# REQUIRED. Use a long random value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# REQUIRED. Password for the restricted `riffle_app` database role that the app
# runs as. Use hex so it is URL-safe: openssl rand -hex 24
RIFFLE_APP_DB_PASSWORD=

# --- Sign-in ---
# The first account can always register. Set true to let anyone else sign up.
ALLOW_REGISTRATION=false
# Session cookies are Secure (HTTPS-only) in production. Set false ONLY when
# serving over plain http, e.g. a trial on localhost.
COOKIE_SECURE=
# Comma-separated extra origins allowed to POST (only needed behind unusual proxies).
TRUSTED_ORIGINS=

# --- Used from Phase 1 onward (not read by the Phase 0 build) ---
# 32-byte key, base64 encoded, for encrypting stored secrets such as the
# SimpleFIN Access URL: openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# SimpleFIN
# Key ring for encrypting stored SimpleFIN Access URLs (required for bank import).
# One or more comma-separated `<id>:<key>` entries; the first is used for new
# writes, the rest only decrypt (rotation). <key> is 32 bytes, base64 or 64 hex.
# Generate: echo "1:$(openssl rand -base64 32)"
# Note: a bare key (no id) is treated as id "1".
# RIFFLE_SECRET_KEY=
# Minimum seconds between manual "import now" calls per connection (default 3600).
# BANK_IMPORT_MIN_INTERVAL_SECONDS=3600

# Background import (worker). Needs DATABASE_URL and RIFFLE_SECRET_KEY on the worker.
# Unset = on when both are present; true = required (fails at start-up if either
# is missing); false = off.
# RIFFLE_IMPORT_ENABLED=
# How often the worker looks for connections that are due, in seconds (5-3600, default 60).
# Each connection is imported once a day, at a stable hour derived from its id.
# RIFFLE_IMPORT_INTERVAL_SECONDS=60
# Connections imported at the same time by one worker (1-8, default 2).
# RIFFLE_IMPORT_CONCURRENCY=2
# Minutes to wait before retrying a connection whose last import failed (15-1440, default 360).
# RIFFLE_IMPORT_RETRY_MINUTES=360
