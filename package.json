{
  "name": "riffle",
  "version": "0.0.0",
  "private": true,
  "description": "Riffle: free and open source small business bookkeeping software",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:api": "pnpm --filter @riffle/api dev",
    "dev:worker": "pnpm --filter @riffle/worker dev",
    "dev:web": "pnpm --filter @riffle/web dev"
  }
}
